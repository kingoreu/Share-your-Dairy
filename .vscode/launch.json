{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "ServerApplication",
      "request": "launch",
      "mainClass": "com.share.dairy.ServerApplication",
      "projectName": "dairy",
      "envFile": "${workspaceFolder}/.env",
      "presentation": { "hidden": true }
    },

    {
      "type": "java",
      "name": "HelloApplication",
      "request": "launch",
      "mainClass": "com.share.dairy.app.HelloApplication",
      "projectName": "dairy",
      "envFile": "${workspaceFolder}/.env",
      "vmArgs": "--module-path \"C:/Java/javafx-sdk-21.0.8/lib\" --add-modules javafx.controls,javafx.fxml,javafx.web --add-exports=javafx.graphics/com.sun.javafx.scene=ALL-UNNAMED --add-exports=javafx.graphics/com.sun.javafx.sg.prism=ALL-UNNAMED --add-exports=javafx.graphics/com.sun.javafx.sg.prism.web=ALL-UNNAMED --add-exports=javafx.graphics/com.sun.javafx.util=ALL-UNNAMED"
    },
    {
      "type": "java",
      "name": "Launcher",
      "request": "launch",
      "mainClass": "com.share.dairy.app.Launcher",
      "projectName": "dairy",
      "envFile": "${workspaceFolder}/.env",
      "vmArgs": "--module-path \"C:/Java/javafx-sdk-21.0.8/lib\" --add-modules javafx.controls,javafx.fxml,javafx.web --add-exports=javafx.graphics/com.sun.javafx.scene=ALL-UNNAMED --add-exports=javafx.graphics/com.sun.javafx.sg.prism=ALL-UNNAMED --add-exports=javafx.graphics/com.sun.javafx.sg.prism.web=ALL-UNNAMED --add-exports=javafx.graphics/com.sun.javafx.util=ALL-UNNAMED"
    },
    {
      "type": "java",
      "name": "Current File",
      "request": "launch",
      "mainClass": "${file}",
      "envFile": "${workspaceFolder}/.env",
      "vmArgs": "--module-path \"C:/Java/javafx-sdk-21.0.8/lib\" --add-modules javafx.controls,javafx.fxml,javafx.web --add-exports=javafx.graphics/com.sun.javafx.scene=ALL-UNNAMED --add-exports=javafx.graphics/com.sun.javafx.sg.prism=ALL-UNNAMED --add-exports=javafx.graphics/com.sun.javafx.sg.prism.web=ALL-UNNAMED --add-exports=javafx.graphics/com.sun.javafx.util=ALL-UNNAMED"
    }
  ],
  "compounds": [
    {
      "name": "HelloApp",
      "configurations": ["HelloApplication"]
    }
  ]
}
